  "progression": {
    "compound": { "reps": [7, 8, 9], "then": "add_load_and_reset" },
    "accessory": { "reps": [10, 12, 15], "then": "add_load_and_reset" },
    "pullup": { "add_reps_per_build_week": 1, "cap_reps": 10, "then": "lighter_band_and_reset" }
  },
  "progression_rules": [
    "Compounds add a rep each build week (7, then 8, then 9). The next build week adds that exercise's load_step_kg and resets to 7 reps. Bench and box squat and deadlift step 5 kg. Overhead press steps 2.5 kg.",
    "Accessories that start at 10 reps go 10, then 12, then 15. The next build week adds load_step_kg when the exercise has one, and resets to 10. Accessories written at another rep count stay on those reps.",
    "Banded pull-ups add one rep per build week. The build week after 10 reps drops to a lighter band (2 red, then 1 red, then bodyweight) and resets to the starting reps.",
    "Deload weeks halve the sets and round up, keep the same load and reps as the previous build week, and stop with 4+ reps in reserve.",
    "Easy runs stay 25-30 minutes with heart rate under 145 bpm, including deload weeks. Walk every day."
  ],
